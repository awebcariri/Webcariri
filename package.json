{
  "name": "webcariri",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender-ssr && node scripts/prerender.mjs",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "og": "node scripts/og/gerar.mjs",
    "verify:seo": "node scripts/verify-prerender.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "^1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
